{
  "expo": {
    "name": "Rack-n-Roll",
    "slug": "rack-n-roll",
    "version": "1.3.7",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4a1520"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "racknroll",
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4a1520"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      "./plugins/withLargeScreenSupport"
    ],
    "extra": {
      "eas": {
        "projectId": "36a3387c-fc35-4a53-93a6-306f4dd04fab"
      }
    },
    "android": {
      "versionCode": 23,
      "package": "com.dhanushcharipally.racknroll",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#4a1520"
      }
    },
    "ios": {
      "buildNumber": "23",
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.dhanushcharipally.racknroll",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro",
      "output": "single",
      "name": "Rack n Roll",
      "shortName": "Rack n Roll",
      "description": "Discover, host, and follow billiards tournaments.",
      "themeColor": "#4a1520",
      "backgroundColor": "#4a1520",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "lang": "en",
      "preferRelatedApplications": false
    }
  }
}
